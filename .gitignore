# ── Local-only launchers and environment config ──────────────────────────
# run_server.py / start_server.py contain machine-specific launch settings and
# are intentionally kept out of the published repository, as is .env.
.env
.env.*
run_server.py
start_server.py

# ── Python ───────────────────────────────────────────────────────────────
.venv/
.venv312/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
thermoequi_agent.egg-info/
*.db
*.sqlite3

# ── Node / frontend build output ─────────────────────────────────────────
node_modules/
.pnpm-store/
.next/
*.tsbuildinfo
out/
coverage/
*.log
pytest-cache-files-*/

# ── Editor / IDE (workspace.xml leaks local absolute paths) ──────────────
.idea/
.vscode/
*.iml

# ── Runtime scratch directories (auto-created by tests and the agent) ────
.tmp/
.tmp-*/
tmp*/
tfchat_*/
e2e_tf_*/

# ── Private ML weights: third-party/private checkpoints ──────────────────
# Members place their own .pth here or point PGSSI_CHECKPOINT elsewhere.
weights/
.pgssi-cache/
*.pth
*.ckpt

# ── Explicit re-includes (negations MUST come last to take effect) ───────
# Safe, credential-free configuration template: required for onboarding.
!.env.example

# Runtime feature caches are never published.
.thermoformer-cache/
data/vector_store.npz

# ── lab_models: published research artifacts (plain Git files) ───────────
# Re-included here so the negation applies to the *.pth / *.ckpt rules above.
!lab_models/**
!lab_models/**/*.pth

# Training experiment records are kept local: they are large (hundreds of MB
# of per-run CSV/JSON evaluation dumps) and are reproducible from the code.
lab_models/**/experiments/

# Keep non-source noise out of lab_models even though the tree is published.
lab_models/**/__pycache__/
lab_models/**/*.pyc
lab_models/**/.ipynb_checkpoints/
lab_models/**/.pytest_cache/
lab_models/**/.mypy_cache/
lab_models/**/.ruff_cache/
lab_models/**/cache/
